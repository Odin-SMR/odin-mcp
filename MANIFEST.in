include README.md LICENSE AGENTS.md pyproject.toml uv.lock .python-version
recursive-include odin_mcp *.py
recursive-include odin_mcp/research *.md *.json
recursive-include docs *.md
recursive-include scripts *.py
recursive-include tests *.py
prune .github
prune .codex
prune .vscode
prune .idea
prune .venv
prune plots
prune data
prune results
prune dist
prune build
global-exclude .env .env.* .envrc *.pem *.key *.p12 *.pfx
global-exclude *.parquet *.nc *.h5 *.hdf *.hdf5 *.npy *.npz
global-exclude *.py[cod] __pycache__ .DS_Store
